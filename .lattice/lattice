def yaml_value(text: str, key: str) -> str:
    """Value of a top-level `key:` in a simple YAML file: one line, an indented
    continuation, or a `|`/`>` block (stdlib only, enough for OpenSpec files)."""
    lines = text.splitlines()
    for i, ln in enumerate(lines):
        m = re.match(rf"^{re.escape(key)}:\s*(.*)$", ln)
        if not m:
            continue
        rest = m.group(1).strip()
        block = rest in ("|", ">", "|-", ">-")
        body = []
        for nxt in lines[i + 1:]:
            if nxt.strip() == "":
                body.append("")
            elif nxt[0] in " \t":
                body.append(nxt)
            else:
                break
        while body and body[-1] == "":
            body.pop()
        if block:
            indent = min((len(b) - len(b.lstrip()) for b in body if b.strip()), default=0)
            return "\n".join(b[indent:] if b.strip() else "" for b in body).strip()
        return " ".join([rest.strip("\"'")] + [b.strip() for b in body if b.strip()]).strip()
    return ""


def md_h1(path: Path) -> str:
    if not path.is_file():
        return ""
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if ln.startswith("# "):
            return re.sub(r"^#\s*(Change:\s*)?", "", ln).strip()
    return ""


def md_section_paragraph(path: Path, heading: str) -> str:
    """First paragraph under the `## <heading>` section of a markdown file."""
    if not path.is_file():
        return ""
    para, inside = [], False
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if ln.startswith("## "):
            if inside:
                break
            inside = ln[3:].strip().lower().startswith(heading.lower())
            continue
        if inside:
            if ln.strip():
                para.append(ln.strip())
            elif para:
                break
    return " ".join(para)


def checkbox_counts(path: Path):
    if not path.is_file():
        return 0, 0
    text = path.read_text(encoding="utf-8", errors="replace")
    done = len(re.findall(r"^\s*- \[[xX]\]", text, re.M))
    return done, done + len(re.findall(r"^\s*- \[ \]", text, re.M))


def scan_mentions(root: Path, needle: str):
    """Lines still mentioning `needle` outside .lattice/, git, and build trees."""
    hits = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SCAN_SKIP_DIRS
                             and (not d.startswith(".") or d in SCAN_KEEP_HIDDEN))
        for fn in sorted(filenames):
            p = Path(dirpath) / fn
            try:
                if p.stat().st_size > 1_000_000:
                    continue
                data = p.read_bytes()
            except OSError:
                continue
            if b"\0" in data[:4096]:
                continue
            for i, ln in enumerate(data.decode("utf-8", errors="replace").splitlines(), 1):
                if needle in ln.lower():
                    hits.append(f"{p.relative_to(root)}:{i}: {ln.strip()[:100]}")
    return hits


def migrate_openspec(root: Path) -> None:
    """Move an OpenSpec tree into .lattice/ by trust tier; nothing is discarded.

    specs/<a>/<b>/spec.md      -> .lattice/spec/<a>-<b>.md
    changes/<id>/              -> .lattice/tasks/<id>/ (+ generated task.md)
    changes/archive/*          -> .lattice/tasks/archive/openspec/*
    config.yaml and the rest   -> .lattice/tasks/archive/openspec/ (provenance);
                                  its `context` is folded into AGENTS.md
    OpenSpec tool files and managed AGENTS.md/CLAUDE.md blocks are removed.
    """
    src = root / "openspec"
    if not src.is_dir():
        raise SystemExit("error: no openspec/ directory here — nothing to migrate")
    lat = lat_dir(root)
    spec_dst, tasks_dst = lat / "spec", lat / "tasks"
    arch_dst = tasks_dst / "archive" / "openspec"
    for d in (spec_dst, tasks_dst, arch_dst):
        d.mkdir(parents=True, exist_ok=True)
    today = datetime.date.today().isoformat()
    n_specs = n_archived = 0
    tasks, complete, removed = [], [], []

    specs = src / "specs"
    if specs.is_dir():
        for f in sorted(specs.rglob("spec.md")):
            name = "-".join(f.parent.relative_to(specs).parts) + ".md"
            dst = spec_dst / name
            if dst.exists():
                dst = spec_dst / (name[:-3] + "-openspec.md")
            shutil.move(str(f), str(dst))
            n_specs += 1

    changes = src / "changes"
    if changes.is_dir():
        for c in sorted(changes.iterdir()):
            if not c.is_dir():
                continue
            if c.name == "archive":
                for a in sorted(c.iterdir()):
                    shutil.move(str(a), str(arch_dst / a.name))
                    n_archived += 1
                continue
            dst = tasks_dst / c.name
            if dst.exists():
                raise SystemExit(
                    f"error: task '{c.name}' already exists — resolve by hand, "
                    f"then rerun (openspec/ is untouched)")
            shutil.move(str(c), str(dst))
            meta_file = dst / ".openspec.yaml"
            meta_text = meta_file.read_text(encoding="utf-8") if meta_file.is_file() else ""
            proposal = dst / "proposal.md"
            goal = (md_section_paragraph(proposal, "Why")
                    or yaml_value(meta_text, "goal")
                    or md_section_paragraph(proposal, "Summary")
                    or "(see proposal.md)")
            done, total = checkbox_counts(dst / "tasks.md")
            if total:
                acceptance = (f"- [ ] All {total} items in tasks.md, each with its own "
                              f"proof ({done} were checked at migration)")
                if done == total:
                    complete.append(c.name)
            else:
                acceptance = ("- [ ] Everything under \"What Changes\" in proposal.md "
                              "is delivered")
            kept = ", ".join(sorted(p.name for p in dst.iterdir()))
            body = (f"\n## Goal\n\n{goal}\n\n## Acceptance\n\n{acceptance}\n"
                    f"- [ ] The behavior described under specs/ holds\n\n"
                    f"## Notes / Dead ends\n\n- Migrated from openspec/changes/{c.name} "
                    f"on {today}; original artifacts kept here: {kept}.\n")
            meta = {"id": c.name, "title": md_h1(proposal) or
                    c.name.replace("-", " ").replace("_", " ").capitalize(),
                    "status": "open", "verify": "",
                    "created": yaml_value(meta_text, "created") or now_iso()}
            write_task(dst / "task.md", meta, body)
            tasks.append(c.name)

    cfg = src / "config.yaml"
    context_text = yaml_value(cfg.read_text(encoding="utf-8"), "context") \
        if cfg.is_file() else ""
    for p in sorted(src.iterdir()):
        if p.is_dir() and not any(p.iterdir()):
            p.rmdir()
        else:
            shutil.move(str(p), str(arch_dst / p.name))
    shutil.rmtree(src, ignore_errors=True)

    agents = root / "AGENTS.md"
    for f in (agents, root / "CLAUDE.md"):
        if f.is_file():
            text = f.read_text(encoding="utf-8")
            new = OPENSPEC_BLOCK.sub("\n", text)
            if new != text:
                f.write_text(new, encoding="utf-8")
                removed.append(f"{f.name}: OpenSpec managed block")
    if context_text:
        if not agents.is_file():
            agents.write_text(AGENTS_SKELETON.format(name=root.name,
                                                     protocol=PROTOCOL_SECTION),
                              encoding="utf-8")
        text = agents.read_text(encoding="utf-8")
        marker = "migrated from openspec/config.yaml"
        if marker not in text:
            section = (f"## Project context ({marker} — verify, then fold into "
                       f"the sections above)\n\n{context_text}\n\n")
            text = text.replace(PROTOCOL_START, section + PROTOCOL_START, 1) \
                if PROTOCOL_START in text else text.rstrip("\n") + "\n\n" + section
            agents.write_text(text, encoding="utf-8")

    for pattern in OPENSPEC_TOOL_GLOBS:
        for p in sorted(root.glob(pattern)):
            shutil.rmtree(p) if p.is_dir() else p.unlink()
            removed.append(str(p.relative_to(root)))
            parent = p.parent
            while parent != root and parent.is_dir() and not any(parent.iterdir()):
                parent.rmdir()
                parent = parent.parent

    print(f"migrated openspec/: {n_specs} spec(s) -> .lattice/spec, {len(tasks)} "
          f"change(s) -> .lattice/tasks, {n_archived} archived -> "
          f".lattice/tasks/archive/openspec (config.yaml kept there)")
    for r in removed:
        print(f"removed {r}")
    if context_text:
        print("folded openspec config context into AGENTS.md — verify it")
    if complete:
        print("every tasks.md item already checked — verify, then `task done "
              "--evidence` and archive: " + ", ".join(complete))
    mentions = scan_mentions(root, "openspec")
    if mentions:
        print(f"still mentioning openspec ({len(mentions)} line(s) — fix by hand):")
        for m in mentions[:25]:
            print(f"  {m}")
        if len(mentions) > 25:
            print(f"  ... and {len(mentions) - 25} more")
    print("next: set `verify:` on the active tasks, fill AGENTS.md, run "
          "`lattice doctor`, commit")


# ---------- init ----------

HOOK_COMMAND = "python3 .lattice/lattice context"
# Both agents read the same hooks schema: {"hooks": {"SessionStart": [{"hooks":
# [{"type": "command", "command": ...}]}]}}. Each injects the command's stdout
# into the model's context when a session starts.
HOOK_FILES = {
    "Claude Code": Path(".claude") / "settings.json",
    "Codex": Path(".codex") / "hooks.json",
}


def load_hook_settings(root: Path, rel: Path) -> dict:
    """Read the shared hook envelope without interpreting unrelated settings."""
    path = root / rel
    if not path.exists():
        return {}
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise ValueError(f"{rel}: cannot read valid hook JSON") from error
    if not isinstance(settings, dict) or not isinstance(settings.get("hooks", {}), dict):
        raise ValueError(f"{rel}: settings and hooks must be JSON objects")
    for event, entries in settings.get("hooks", {}).items():
        if not isinstance(entries, list):
            raise ValueError(f"{rel}: hook events must contain entry lists")
        for entry in entries:
            if not isinstance(entry, dict) or not isinstance(entry.get("hooks"), list) \
                    or not all(isinstance(h, dict) for h in entry["hooks"]):
                raise ValueError(f"{rel}: hook entries must contain lists of hook objects")
    return settings


def owned_hooks(settings: dict, command: str):
    return [(event, entry, hook)
            for event, entries in settings.get("hooks", {}).items()
            for entry in entries for hook in entry["hooks"]
            if hook.get("command") == command]


def session_hook_issue(settings: dict, command: str = HOOK_COMMAND) -> str:
    owned = owned_hooks(settings, command)
    if len(owned) != 1:
        return "expected exactly one Lattice SessionStart command"
    event, entry, hook = owned[0]
    if event != "SessionStart" or entry.get("matcher") not in (None, "", "*", ".*") \
            or hook.get("type") != "command" or hook.get("async", False) is not False:
        return "Lattice hook must be an unconditional synchronous SessionStart command"
    return ""


def protocol_block(text: str) -> str:
    """Reject ambiguous managed markers instead of replacing user prose."""
    starts, ends = text.count(PROTOCOL_START), text.count(PROTOCOL_END)
    if not starts and not ends:
        return ""
    if starts != 1 or ends != 1 or text.index(PROTOCOL_START) > text.index(PROTOCOL_END):
        raise ValueError("AGENTS.md: malformed or duplicate Lattice protocol markers")
    return text[text.index(PROTOCOL_START):text.index(PROTOCOL_END) + len(PROTOCOL_END)]


def has_agents_import(text: str) -> bool:
    """Recognize a real import rather than a comment or Markdown example."""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    fence = ""
    for line in text.splitlines():
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if fence:
            if re.fullmatch(r" {0,3}" + re.escape(fence[0]) +
                            "{" + str(len(fence)) + r",}\s*", line):
                fence = ""
            continue
        if marker:
            fence = marker.group(1)
            continue
        plain = re.sub(r"(`+).*?\1", "", line)
        if re.search(r"(?<!\S)@(?:\./)?AGENTS\.md(?=\s|$)", plain):
            return True
    return False


def entrypoint_issues(root: Path):
    issues = []
    agents = root / "AGENTS.md"
    if not agents.is_file():
        issues.append("AGENTS.md missing — run `lattice init`")
    else:
        try:
            if protocol_block(agents.read_text(encoding="utf-8")) != PROTOCOL_SECTION:
                issues.append("AGENTS.md: Lattice protocol missing or outdated — run `lattice init`")
        except ValueError as error:
            issues.append(str(error))
    claude = root / "CLAUDE.md"
    if not claude.is_file() or not has_agents_import(claude.read_text(encoding="utf-8")):
        issues.append("CLAUDE.md missing or lacks '@AGENTS.md' import")
    try:
        mode = hook_mode(primary_root(root))
        if mode["mode"] == "user":
            issues.extend(user_hook_issues(primary_root(root), Path(mode["user_dir"])))
    except ValueError as error:
        issues.append(str(error))
        mode = {"mode": "invalid"}
    for agent, rel in HOOK_FILES.items():
        try:
            settings = load_hook_settings(root, rel)
            issue = session_hook_issue(settings) if mode["mode"] == "project" else (
                "redundant project hook in user mode" if owned_hooks(settings, HOOK_COMMAND) else "")
            if issue:
                issues.append(f"{agent} ({rel}): {issue} — run `lattice init`")
        except ValueError as error:
            issues.append(str(error))
    vendored = lat_dir(root) / "lattice"
    if not vendored.is_file() or vendored.read_bytes() != Path(__file__).read_bytes():
        issues.append(".lattice/lattice differs from the running CLI — run `lattice init` with the intended version")
    return issues


def remove_hook(settings: dict, command: str) -> bool:
    changed = False
    for event, entries in settings.get("hooks", {}).items():
        kept = []
        for entry in entries:
            remaining = [h for h in entry["hooks"] if h.get("command") != command]
            if len(remaining) == len(entry["hooks"]):
                kept.append(entry)
            else:
                changed = True
                if remaining:
                    kept.append(dict(entry, hooks=remaining))
        settings["hooks"][event] = kept
    return changed


def install_session_hook(root: Path, rel: Path, agent: str,
                         command: str = HOOK_COMMAND) -> bool:
    """Merge a SessionStart hook into one agent's JSON settings (idempotent),
    so every new session begins with the lattice bundle without anyone asking.
    Codex additionally asks the user once to trust a project-level hook."""
    path = root / rel
    settings = load_hook_settings(root, rel)
    if not session_hook_issue(settings, command):
        return False
    # Only the exact managed command is ours. Preserve custom commands,
    # entry metadata, ordering, and settings outside these owned hooks.
    remove_hook(settings, command)
    hooks = settings.setdefault("hooks", {})
    hooks.setdefault("SessionStart", []).append(
        {"hooks": [{"type": "command", "command": command}]})
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(path, json.dumps(settings, indent=2) + "\n")
    return True


# ---------- optional, explicit user integration ----------

def default_user_dir() -> Path:
    return Path.home() / ".local/share/lattice"


def git_common_dir(root: Path):
    rc, value, _ = run_git(root, "rev-parse", "--git-common-dir")
    if rc != 0:
        return None
    path = Path(value)
    return (path if path.is_absolute() else root / path).resolve()


def hook_mode(root: Path) -> dict:
    path = runtime_dir(root) / "hooks.json"
    if not path.exists():
        return {"mode": "project"}
    try:
        mode = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(mode, dict) and mode.get("mode") in ("project", "user"):
            if mode["mode"] == "project" or (
                    isinstance(mode.get("user_dir"), str) and Path(mode["user_dir"]).is_absolute()):
                return mode
    except (ValueError, OSError):
        pass
    raise ValueError(".lattice/runtime/hooks.json: invalid local hook mode")


def load_user_config(folder: Path) -> dict:
    try:
        config = json.loads((folder / "config.json").read_text(encoding="utf-8"))
        def absolute(value):
            return isinstance(value, str) and Path(value).is_absolute()
        if isinstance(config, dict) and config.get("format") == 1 \
                and absolute(config.get("python")) and absolute(config.get("git")) \
                and isinstance(config.get("command"), str) \
                and isinstance(config.get("agents"), dict) and set(config["agents"]) == set(HOOK_FILES) \
                and all(absolute(p) for p in config["agents"].values()) \
                and isinstance(config.get("projects"), dict) \
                and all(absolute(p) and absolute(g) for p, g in config["projects"].items()):
            return config
    except (ValueError, OSError):
        pass
    raise ValueError(f"{folder}: missing or invalid user hooks config; run `lattice hooks install`")


def user_hook_issues(root, folder: Path):
    try:
        config = load_user_config(folder)
        issues = []
        for agent, path in config["agents"].items():
            problem = session_hook_issue(load_hook_settings(Path(path).parent, Path(path).name),
                                         user_hook_command(config, agent))
            if problem:
                issues.append(f"{agent} user hook: {problem} — run `lattice hooks install`")
        for key in ("python", "git"):
            if not Path(config[key]).is_file():
                issues.append(f"user hook {key} executable is missing — run `lattice hooks install`")
        installed = folder / "lattice"
        if not installed.is_file() or installed.read_bytes() != Path(__file__).read_bytes():
            issues.append("central Lattice script differs — run `lattice hooks install` with the intended version")
        if root is not None and config["projects"].get(str(root.resolve())) != str(git_common_dir(root)):
            issues.append("project is not enrolled in user hooks — run `lattice init --hooks user`")
        return issues
    except (ValueError, OSError) as error:
        return [str(error)]


def backup_user_file(folder: Path, path: Path):
    """Keep first-install recovery copies private; never print their content."""
    backups = folder / "backups"
    backups.mkdir(mode=0o700, exist_ok=True)
    name = hashlib.sha256(str(path).encode()).hexdigest()
    receipt = backups / (name + ".json")
    if receipt.exists():
        return
    existed = path.exists()
    if existed:
        destination = backups / (name + ".original")
        destination.write_bytes(path.read_bytes())
        destination.chmod(0o600)
    write_json(receipt, {"path": str(path), "existed": existed})
    receipt.chmod(0o600)


def user_hook_command(config, agent):
    return config["command"] + " --agent " + shlex.quote(agent)


def cmd_hooks_install(args) -> int:
    folder = Path(args.user_dir or default_user_dir()).expanduser().resolve()
    try:
        previous = load_user_config(folder) if (folder / "config.json").exists() else None
        agents = previous["agents"] if previous else {
            agent: str(Path.home() / rel) for agent, rel in HOOK_FILES.items()}
        agents = dict(agents)
        for agent, override in (("Codex", args.codex_config), ("Claude Code", args.claude_config)):
            if override:
                agents[agent] = str(Path(override).expanduser().resolve())
        # Relocating an existing profile must not leave a second active hook.
        if previous and agents != previous["agents"]:
            raise ValueError("user hook config paths changed; remove the old integration first")
        for path in agents.values():
            load_hook_settings(Path(path).parent, Path(path).name)
        python = str(Path(sys.executable).resolve())
        git_path = shutil.which("git")
        if not git_path:
            raise ValueError("git executable not found")
        # -I ignores project PYTHONPATH and user-site startup customizations.
        command = shlex.join([python, "-I", str(folder / "lattice"), "hooks", "context"])
        folder.mkdir(mode=0o700, parents=True, exist_ok=True)
        with file_lock(folder / "config.lock", "user hooks"):
            # Reload under lock so a concurrent enrollment is never overwritten.
            previous = load_user_config(folder) if (folder / "config.json").exists() else None
            for path in agents.values():
                backup_user_file(folder, Path(path))
            installed = folder / "lattice"
            atomic_write(installed, Path(__file__).read_text(encoding="utf-8"))
            installed.chmod(0o755)
            for agent, path in agents.items():
                target = Path(path)
                if previous and previous["command"] != command:
                    settings = load_hook_settings(target.parent, target.name)
                    if remove_hook(settings, user_hook_command(previous, agent)):
                        write_json(target, settings)
                install_session_hook(target.parent, target.name, agent,
                                     user_hook_command({"command": command}, agent))
            write_json(folder / "config.json", {
                "format": 1, "python": python, "git": str(Path(git_path).resolve()),
                "command": command, "agents": agents,
                "projects": previous["projects"] if previous else {}})
        print(f"installed lattice {VERSION} user hooks at {folder}")
        print("Codex: review the user hook in /hooks; native trust is not changed by this command.")
        print("Next: lattice init --hooks user in each selected primary checkout.")
        return 0
    except ValueError as error:
        raise SystemExit(f"error: {error}")


def cmd_hooks_status(args) -> int:
    folder = Path(args.user_dir or default_user_dir()).expanduser().resolve()
    try:
        config = load_user_config(folder)
    except ValueError as error:
        raise SystemExit(f"error: {error}")
    issues = user_hook_issues(None, folder)
    print(f"User hooks: {folder}; {len(config['projects'])} enrolled projects")
    for project in sorted(config["projects"]):
        print(f"- {project}")
    for issue in issues:
        print(f"warn: {issue}")
    print("Native hook trust/loading is checked by the agent, not this status command.")
    return int(bool(issues))


def cmd_hooks_context(args) -> int:
    """Read-only dispatcher. Never import, invoke, or migrate a repository CLI."""
    global HOOK_GIT
    original_cwd = Path.cwd()
    try:
        if sys.stdin.isatty():
            return 0
        payload = json.loads(sys.stdin.read(65537))
        if not isinstance(payload, dict) or not isinstance(payload.get("cwd"), str) \
                or payload.get("hook_event_name", "SessionStart") != "SessionStart":
            return 0
        cwd = Path(payload["cwd"])
        if not cwd.is_absolute():
            return 0
        cwd = cwd.resolve()
        folder = Path(__file__).resolve().parent
        config = load_user_config(folder)
        # Check enrollment before touching the candidate repository or Git.
        candidates = [Path(p) for p in config["projects"] if cwd == Path(p) or Path(p) in cwd.parents]
        if not candidates:
            return 0
        root = max(candidates, key=lambda p: len(p.parts))
        HOOK_GIT = config["git"]
        rc, value, _ = run_git(cwd, "rev-parse", "--show-toplevel")
        if rc != 0:
            return 0
        here = Path(value).resolve()
        worktrees = root / ".lattice/worktrees"
        if here != root and here.parent != worktrees:
            return 0
        if str(git_common_dir(here)) != config["projects"][str(root)]:
            return 0
        mode = hook_mode(root)
        if mode["mode"] != "user" or Path(mode["user_dir"]).resolve() != folder:
            return 0
        # Old branches/worktrees may still carry the old hook. Let that hook
        # provide the bundle until init refreshes the checkout; never double it.
        if owned_hooks(load_hook_settings(here, HOOK_FILES[args.agent]), HOOK_COMMAND):
            return 0
        os.chdir(here)
        return cmd_context(args)
    except (ValueError, OSError, subprocess.TimeoutExpired):
        return 0
    finally:
        HOOK_GIT = None
        os.chdir(original_cwd)


def cmd_init(args) -> int:
    root = repo_root()
    primary = primary_root(root)
    # Validate editable envelopes before vendoring or migrating anything.
    try:
        for rel in HOOK_FILES.values():
            load_hook_settings(root, rel)
        if (root / "AGENTS.md").is_file():
            protocol_block((root / "AGENTS.md").read_text(encoding="utf-8"))
        mode = hook_mode(primary)
        selected = args.hooks or mode["mode"]
        user_dir = Path(args.user_dir or mode.get("user_dir") or default_user_dir()).expanduser().resolve()
        if mode["mode"] == "user" and user_dir != Path(mode["user_dir"]):
            raise ValueError("switch to project hook mode before changing --user-dir")
        if args.user_dir and selected != "user":
            raise ValueError("--user-dir requires user hook mode")
        if selected == "user":
            problems = user_hook_issues(None, user_dir)
            if problems:
                raise ValueError("; ".join(problems))
            if not git_common_dir(root) or (primary != root and mode["mode"] != "user"):
                raise ValueError("select hook mode from the primary git checkout")
        elif mode["mode"] == "user":
            if primary != root:
                raise ValueError("select hook mode from the primary git checkout")
            load_user_config(user_dir)
    except ValueError as error:
        raise SystemExit(f"error: {error}; repair it explicitly, then rerun init")
    if args.from_openspec:
        migrate_openspec(root)
    elif (root / "openspec").is_dir():
        print("note: openspec/ found — `lattice init --from-openspec` migrates it "
              "into .lattice/ (nothing is discarded)")
    lat = lat_dir(root)
    for sub in ("intent", "spec", "tasks/archive"):
        (lat / sub).mkdir(parents=True, exist_ok=True)

    self_path = Path(__file__).resolve()
    vendored = lat / "lattice"
    if vendored.resolve() != self_path:
        changed = not vendored.exists() or vendored.read_bytes() != self_path.read_bytes()
        if changed:
            shutil.copyfile(self_path, vendored)
            vendored.chmod(0o755)
            print(f"vendored lattice {VERSION} as .lattice/lattice")

    ignore = lat / ".gitignore"
    ignored = ignore.read_text(encoding="utf-8").splitlines() if ignore.exists() else []
    for entry in ("worktrees/", "runtime/"):
        if entry not in ignored:
            ignored.append(entry)
    atomic_write(ignore, "\n".join(ignored) + "\n")
    with locked(primary_root(root), "board"):
        migrate_task_state(primary_root(root))

    agents = root / "AGENTS.md"
    if not agents.exists():
        agents.write_text(
            AGENTS_SKELETON.format(name=root.name, protocol=PROTOCOL_SECTION),
            encoding="utf-8",
        )
        print(f"created {agents.name} (skeleton — fill in verified facts)")
    else:
        text = agents.read_text(encoding="utf-8")
        # Rewire the live manual, not dated receipts or preserved legacy files.
        updated = text.replace(
            "Current status/progress never does — that lives in git and `.lattice/tasks/`.",
            "Current status/progress lives in `.lattice/runtime/tasks/`; archives enter git.")
        updated = re.sub(r"\.lattice/tasks/(?!archive(?:/|`|\\s))(?=[A-Za-z0-9<])",
                         ".lattice/runtime/tasks/", updated)
        if updated != text:
            atomic_write(agents, updated)
            text = updated
            print("updated active-task paths in AGENTS.md")
        if PROTOCOL_START not in text:
            with agents.open("a", encoding="utf-8") as fh:
                fh.write("\n" + PROTOCOL_SECTION + "\n")
            print(f"appended Lattice protocol section to existing {agents.name}")
        else:
            current = protocol_block(text)
            if current != PROTOCOL_SECTION:
                agents.write_text(text.replace(current, PROTOCOL_SECTION),
                                  encoding="utf-8")
                print(f"updated Lattice protocol section in {agents.name}")

    claude = root / "CLAUDE.md"
    if not claude.exists():
        claude.write_text("@AGENTS.md\n", encoding="utf-8")
        print("created CLAUDE.md -> @AGENTS.md")
    elif not has_agents_import(claude.read_text(encoding="utf-8")):
        with claude.open("a", encoding="utf-8") as fh:
            fh.write("\n@AGENTS.md\n")
        print("appended @AGENTS.md import to existing CLAUDE.md")

    if selected == "user":
        with file_lock(user_dir / "config.lock", "user hooks"):
            config = load_user_config(user_dir)
            config["projects"][str(primary.resolve())] = str(git_common_dir(primary))
            write_json(user_dir / "config.json", config)
            write_json(runtime_dir(primary) / "hooks.json",
                       {"mode": "user", "user_dir": str(user_dir)})
        for agent, rel in HOOK_FILES.items():
            settings = load_hook_settings(root, rel)
            if remove_hook(settings, HOOK_COMMAND):
                write_json(root / rel, settings)
                print(f"removed redundant {agent} project hook from {rel}")
        print(f"enrolled in user hooks: {user_dir}")
    else:
        for agent, rel in HOOK_FILES.items():
            if install_session_hook(root, rel, agent):
                print(f"installed {agent} SessionStart hook in {rel} "
                      f"(auto-injects `lattice context`)")
        if mode["mode"] == "user":
            with file_lock(user_dir / "config.lock", "user hooks"):
                config = load_user_config(user_dir)
                config["projects"].pop(str(primary.resolve()), None)
                write_json(user_dir / "config.json", config)
                write_json(runtime_dir(primary) / "hooks.json", {"mode": "project"})

    init_knowledge(root)
    print(f"lattice initialized at {lat}")
    return 0


# ---------- shared knowledge discovery ----------

KNOWLEDGE_PATH = Path(".lattice/knowledge.md")
MARKDOWN_BYTES = 512 * 1024
SEARCH_FILES = 4000
SEARCH_BYTES = 32 * 1024 * 1024


def bounded_markdown(path: Path, root: Path, limit=MARKDOWN_BYTES):
    """Read an ordinary file inside root; never follow links or wait on pipes."""
    try:
        relative = path.relative_to(root)
        if any((root / Path(*relative.parts[:i])).is_symlink()
               for i in range(1, len(relative.parts) + 1)):
            return None
        flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
        with os.fdopen(os.open(path, flags), "rb") as source:
            info = os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
                return None
            data = source.read(limit + 1)
        return data.decode("utf-8") if len(data) <= limit else None
    except (OSError, UnicodeError, ValueError):
        return None


def knowledge_issues(root: Path):
    content = bounded_markdown(root / KNOWLEDGE_PATH, root, 65536)
    if content is None:
        return [".lattice/knowledge.md missing, unsafe, or over 64 KiB; run init or repair the knowledge index"]
    issues = []
    for link in re.findall(r"\[[^\]\n]+\]\(([^)\n]+)\)", content):
        target = link.split("#", 1)[0].strip().strip("<>")
        if not target or re.match(r"[a-zA-Z][a-zA-Z0-9+.-]*:", target):
            continue
        resolved = (root / KNOWLEDGE_PATH.parent / target).resolve()
        if (resolved != root and root not in resolved.parents) or not resolved.exists():
            issues.append(f"knowledge index has missing or out-of-repo source: {target[:180]}")
    return issues


def init_knowledge(root: Path):
    target = root / KNOWLEDGE_PATH
    if target.exists() or target.is_symlink():
        return
    links = ["- [Agent manual](../AGENTS.md)"]
    for relative, title in (("README.md", "Project overview"),
                            ("docs/README.md", "Documentation")):
        if (root / relative).is_file():
            links.append(f"- [{title}](../{relative})")
    links += ["- Behavior contracts: `.lattice/spec/` (when present)",
              "- Design decisions: `.lattice/intent/` (when present)"]
    atomic_write(target, "---\ntype: contract\n---\n# Project knowledge\n\n"
                 "Map maintained sources here: product constraints, architecture, commands,\n"
                 "operations and access prerequisites, and acceptance boundaries. Keep facts\n"
                 "in those sources; this index is not a second status ledger.\n\n"
                 + "\n".join(links) + "\n\n"
                 "Use `python3 .lattice/lattice find \"<term>\"` before asking for prior\n"
                 "information again. Active work is in the shared task board; archives are\n"
                 "historical. Date operational observations, link evidence and recheck steps,\n"
                 "and store credential locations only. Missing evidence stays unverified.\n")
    print("created .lattice/knowledge.md (curate links to maintained project sources)")


def knowledge_files(here: Path, root: Path):
    # Only explicit documentation areas: no provider histories, env files, source
    # dependency trees, arbitrary home directories, or remote resources.
    for path in sorted(here.glob("*.md")):
        if not path.name.startswith(".") or path.name == ".agent-handoff.md":
            yield path, here, "document"
    yield here / KNOWLEDGE_PATH, here, "document"
    areas = [(here / "docs", here, "document"),
             (here / "wiki", here, "document"),
             (here / ".lattice/spec", here, "document"),
             (here / ".lattice/intent", here, "document"),
             (tasks_dir(root), root, "active task; local"),
             (here / ".lattice/tasks/archive", here, "archive; historical")]
    ignored = {"node_modules", "vendor", "third_party", "build", "dist", "evidence"}
    visited = 0
    for base, allowed, kind in areas:
        if base.is_symlink():
            yield base, allowed, kind
            continue
        for current, dirs, names in os.walk(base, followlinks=False):
            visited += 1
            if visited > SEARCH_FILES:
                yield None, allowed, kind
                return
            parent = Path(current)
            # Surface skipped links without traversing them.
            for name in sorted(dirs):
                if (parent / name).is_symlink():
                    yield parent / name, allowed, kind
            dirs[:] = sorted(d for d in dirs if not d.startswith(".")
                             and d not in ignored and not (parent / d).is_symlink()
                             and not (parent / d / ".git").exists())
            for name in sorted(names):
                if name.endswith(".md") and not name.startswith("."):
                    yield parent / name, allowed, kind


def cmd_find(args) -> int:
    here = repo_root()
    root = primary_root(here)
    query = args.query.casefold().strip()
    if not query or not 1 <= args.limit <= 50:
        raise SystemExit("error: provide a nonempty literal query and --limit between 1 and 50")
    found = scanned = skipped = size = 0
    stopped = ""
    for path, allowed, kind in knowledge_files(here, root):
        if path is None or scanned >= SEARCH_FILES or size >= SEARCH_BYTES:
            stopped = "scan budget reached"
            break
        scanned += 1
        content = bounded_markdown(path, allowed)
        if content is None:
            skipped += 1
            continue
        size += len(content.encode("utf-8"))
        number = next((n for n, line in enumerate(content.splitlines(), 1)
                       if query in line.casefold()), None)
        relative = path.relative_to(allowed).as_posix()
        if number is None and query not in relative.casefold():
            continue
        if kind == "document":
            match = re.match(r"---\s*\n(.*?)\n---(?:\n|$)", content, re.S)
            declared = yaml_value(match[1], "type") if match else ""
            if not declared:
                declared = "contract" if relative.startswith(".lattice/spec/") else \
                    "intent" if relative.startswith(".lattice/intent/") else ""
            kind = declared if declared in ("contract", "intent") else "state; reverify" \
                if declared == "state" else "untyped; reverify"
        location = str(path) if allowed != here or "active task" in kind else relative
        # Content can contain secrets. Return locations and trust class only.
        print(f"{location}:{number or 1} [{kind}]")
        found += 1
        if found >= args.limit:
            stopped = "result limit reached"
            break
    print(f"{found} matching files; {scanned} candidates scanned; {skipped} skipped"
          + (f"; {stopped}" if stopped else ""))
    print("Discovery only: absence is not proof of missing knowledge. Read the selected sources, "
          "reverify state, and use targeted repository search if coverage was insufficient.")
    return 0


