# ---------- git & paths ----------

def run_git(root: Path, *args: str):
    try:
        # The user hook must not execute repository fsmonitor commands or let
        # inherited Git overrides redirect its read-only queries elsewhere.
        prefix = [HOOK_GIT, "--no-pager", "-c", "core.fsmonitor=false",
                  "-c", "log.showSignature=false"] if HOOK_GIT else ["git"]
        env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")} if HOOK_GIT else None
        if env is not None:
            env["GIT_OPTIONAL_LOCKS"] = "0"
        res = subprocess.run([*prefix, "-C", str(root), *args],
                             capture_output=True, text=True, env=env,
                             timeout=5 if HOOK_GIT else None)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except FileNotFoundError:
        return 127, "", "git unavailable"


def git(root: Path, *args: str) -> str:
    rc, out, _ = run_git(root, *args)
    return out if rc == 0 else "(git unavailable)"


def repo_root() -> Path:
    rc, out, _ = run_git(Path.cwd(), "rev-parse", "--show-toplevel")
    return Path(out) if rc == 0 else Path.cwd()


def primary_root(root: Path) -> Path:
    """The main working tree's root. Inside a linked worktree, task state still
    lives in the primary tree so every session reads one shared board."""
    rc, out, _ = run_git(root, "rev-parse", "--git-common-dir")
    if rc != 0:
        return root
    common = Path(out)
    if not common.is_absolute():
        common = (root / common).resolve()
    return common.parent if common.name == ".git" else root


def lat_dir(root: Path) -> Path:
    return root / ".lattice"


def runtime_dir(root: Path) -> Path:
    return lat_dir(root) / "runtime"


def tasks_dir(root: Path) -> Path:
    return runtime_dir(root) / "tasks"


def check_task_id(task_id: str) -> None:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", task_id):
        raise SystemExit("error: invalid task id")


@contextmanager
def locked(root: Path, scope: str):
    """OS-owned, non-blocking operation locks. Never unlink a lock's inode.

    Task locks span verification; the board lock spans only short mutations.
    These protect CLI operations, not arbitrary git commands or manual edits.
    """
    folder = runtime_dir(root) / "locks"
    name = hashlib.sha256(scope.encode()).hexdigest() + ".lock"
    with file_lock(folder / name, scope):
        yield


@contextmanager
def file_lock(path: Path, scope: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+b") as fh:
        if os.name == "nt":
            import msvcrt
            if fh.tell() == 0:
                fh.write(b"\0")
                fh.flush()
            fh.seek(0)
            try:
                msvcrt.locking(fh.fileno(), msvcrt.LK_NBLCK, 1)
            except OSError:
                raise SystemExit(f"error: another lattice operation holds {scope}; retry when it finishes")
        else:
            import fcntl
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise SystemExit(f"error: another lattice operation holds {scope}; retry when it finishes")
        try:
            yield
        finally:
            if os.name == "nt":
                fh.seek(0)
                msvcrt.locking(fh.fileno(), msvcrt.LK_UNLCK, 1)
            else:
                fcntl.flock(fh, fcntl.LOCK_UN)


def atomic_write(path: Path, text: str) -> None:
    if path.is_file() and path.read_bytes() == text.encode("utf-8"):
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".write-", dir=path.parent)
    try:
        os.chmod(temporary, path.stat().st_mode & 0o777 if path.exists() else 0o644)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def write_json(path: Path, value) -> None:
    atomic_write(path, json.dumps(value, indent=2, ensure_ascii=False) + "\n")


def read_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        raise SystemExit(f"error: missing or invalid record {path}")


def current_branch(tree: Path) -> str:
    rc, out, _ = run_git(tree, "symbolic-ref", "--short", "-q", "HEAD")
    return out if rc == 0 else ""


def branch_exists(root: Path, branch: str) -> bool:
    rc, _, _ = run_git(root, "rev-parse", "--verify", "--quiet",
                       f"refs/heads/{branch}")
    return rc == 0


def default_branch(root: Path) -> str:
    """The mainline: `git config lattice.main <branch>` if set and present,
    else main or master."""
    rc, out, _ = run_git(root, "config", "--get", "lattice.main")
    if rc == 0 and out and branch_exists(root, out):
        return out
    for name in PROTECTED_BRANCHES:
        if branch_exists(root, name):
            return name
    return ""


def is_dirty(tree: Path) -> bool:
    rc, out, _ = run_git(tree, "status", "--porcelain")
    if rc != 0:
        raise SystemExit(f"error: cannot inspect git status in {tree}")
    return bool(out)


def default_owner() -> str:
    """LATTICE_OWNER wins; otherwise the agent is detected from its environment:
    Claude Code exports CLAUDECODE, Codex child processes carry CODEX_* variables
    (CODEX_MANAGED_BY_NPM from its launcher, CODEX_SANDBOX under its sandbox)."""
    if os.environ.get("LATTICE_OWNER"):
        return os.environ["LATTICE_OWNER"]
    if os.environ.get("CLAUDECODE"):
        return "claude"
    if any(k.startswith("CODEX_") for k in os.environ):
        return "codex"
    return getpass.getuser()


def now_iso() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40].strip("-") or "task"


SHELL_WORDS = {"cd", "export", "set", "source", ".", "if", "for", "while", "until",
               "case", "!", "[", "[[", "(", "{", "time"}


def verify_looks_runnable(cmd: str) -> bool:
    """Cheap lint for `verify:`: its first word must be an executable, a shell
    word, an env assignment, or a path — prose like 'see tasks.md' is not."""
    words = cmd.split()
    first = words[0] if words else ""
    return (not first or first in SHELL_WORDS or "=" in first
            or first[0] in "/.~$(" or shutil.which(first) is not None)


RUNTIME_PATH = ".lattice/runtime/"


def verify_issue(cmd: str) -> str:
    """Lint `verify:`. Prose cannot run, and a machine-local runtime path stops
    meaning anything once archive moves the task folder."""
    if not verify_looks_runnable(cmd):
        return (f"verify '{cmd[:40]}' is not a shell command — `task done` will "
                f"fail; fix `verify:` or plan on --evidence")
    if RUNTIME_PATH in cmd:
        return (f"verify hard-codes {RUNTIME_PATH}; reference task files through "
                f"$LATTICE_TASK_DIR so the command survives archive")
    return ""


# ---------- task file frontmatter ----------

def read_task(path: Path):
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        raise  # A concurrent archive may move a task while the board is read.
    except (UnicodeError, OSError) as error:
        raise SystemExit(f"error: cannot read task file {path}: {error}") from None
    m = re.match(r"\A---\n(.*?)\n---\n(.*)\Z", text, re.DOTALL)
    if not m:
        raise SystemExit(f"error: malformed frontmatter in {path}")
    meta = {}
    for line in m.group(1).splitlines():
        if ":" in line:
            key, _, val = line.partition(":")
            meta[key.strip()] = val.strip()
    if not meta.get("id") or "status" not in meta:
        raise SystemExit(f"error: task frontmatter needs id and status in {path}")
    return meta, m.group(2)


def write_task(path: Path, meta: dict, body: str) -> None:
    front = "\n".join(f"{k}: {meta.get(k, '')}" for k in TASK_KEYS)
    if any("\n" in str(meta.get(k, "")) or "\r" in str(meta.get(k, "")) for k in TASK_KEYS):
        raise SystemExit("error: task fields must be single-line strings")
    atomic_write(path, f"---\n{front}\n---\n{body}")


def iter_tasks(root: Path, broken=None):
    """Yield (path, meta, body) per live task. Read-only commands pass a
    `broken` list so one damaged task.md is reported instead of hiding the
    whole board; mutations keep the default and fail closed on it."""
    tasks = tasks_dir(root)
    if not tasks.is_dir():
        return
    for d in sorted(tasks.iterdir()):
        if d.name == "archive" or not d.is_dir():
            continue
        f = d / "task.md"
        if not f.is_file():
            continue
        try:
            yield f, *read_task(f)
        except FileNotFoundError:
            continue  # An archive may move a task while a reader lists it.
        except SystemExit as error:
            if broken is None:
                raise
            broken.append(f"unreadable task {d.name}: {str(error).replace('error: ', '', 1)}")


def find_task(root: Path, task_id: str):
    check_task_id(task_id)
    f = tasks_dir(root) / task_id / "task.md"
    if not f.is_file():
        raise SystemExit(f"error: no task '{task_id}' (see: lattice task list)")
    meta, body = read_task(f)
    if meta.get("id") != task_id:
        raise SystemExit(f"error: task id does not match its directory: {f}")
    return f, meta, body


def task_tree(root: Path, meta: dict, here: Path) -> Path:
    """Resolve only the registered tree on the claimed branch; no cwd fallback."""
    tree = (root / (meta.get("tree") or meta.get("worktree") or ".")).resolve()
    if tree != root and root not in tree.parents:
        raise SystemExit("error: task tree is outside this repository")
    rc, top, _ = run_git(tree, "rev-parse", "--show-toplevel")
    if rc != 0 or Path(top).resolve() != tree or primary_root(tree) != root \
            or current_branch(tree) != meta.get("branch"):
        raise SystemExit(f"error: task {meta['id']} is not checked out on "
                         f"{meta.get('branch')} at {tree}; restore its checkout first")
    return tree


def migrate_task_state(root: Path, announce: bool = True) -> None:
    """Keep old versioned artifacts verbatim; import each legacy id once.

    Subsequent init calls can discover old tasks on another branch. The import
    ledger prevents a checkout from resurrecting an already archived task.
    Legacy success is never accepted as structured verification evidence.
    """
    tasks_dir(root).mkdir(parents=True, exist_ok=True)
    atomic_write(runtime_dir(root) / ".gitignore", "*\n")
    ledger = runtime_dir(root) / "legacy-imports.json"
    seen = set(read_json(ledger)) if ledger.exists() else set()
    for f in sorted((lat_dir(root) / "tasks").glob("*/task.md")):
        if f.parent.name == "archive" or f.parent.name in seen:
            continue
        meta, body = read_task(f)
        tid = meta["id"]
        check_task_id(tid)
        if tid != f.parent.name:
            raise SystemExit(f"error: legacy task id does not match its directory: {f}")
        if any((lat_dir(root) / "tasks/archive").glob(f"*/{tid}")):
            seen.add(tid)
            write_json(ledger, sorted(seen))
            continue
        dest = tasks_dir(root) / tid
        if not dest.exists():
            shutil.copytree(f.parent, dest)
            meta["tree"] = meta.get("worktree") or "."
            if meta.get("status") == "done":
                meta["status"] = "in_progress" if meta.get("branch") else "open"
            meta.update(verified="", done="")
            write_task(dest / "task.md", meta, body)
            if announce:
                print(f"imported {tid} into shared runtime; legacy artifacts kept, reverify before archive")
        seen.add(tid)
        write_json(ledger, sorted(seen))
    atomic_write(runtime_dir(root) / "format", "1\n")


def archived_task(root: Path, tid: str):
    """The archived folder of a task id, if any."""
    return next(iter(sorted((lat_dir(root) / "tasks/archive").glob(f"*/{tid}"))), None)


def legacy_folder_issue(folder: Path, archived: Path) -> str:
    """Empty when everything except the superseded task.md is byte-identical
    in the archive; otherwise names the first file whose removal would lose data."""
    for path in sorted(folder.rglob("*")):
        rel = path.relative_to(folder).as_posix()
        if rel == "task.md" or (path.is_dir() and not path.is_symlink()):
            continue
        twin = archived / rel
        if path.is_symlink() or not twin.is_file() or twin.read_bytes() != path.read_bytes():
            return f"{rel} differs from the archive"
    return ""


def retire_legacy_folder(root: Path, tid: str) -> str:
    """Once a task is archived, its imported versioned folder is a duplicate
    that reads like a live record. Remove it only when nothing is lost."""
    folder = lat_dir(root) / "tasks" / tid
    archived = archived_task(root, tid)
    if archived is None or folder.is_symlink() or not folder.is_dir():
        return ""
    problem = legacy_folder_issue(folder, archived)
    if problem:
        return f"warn: legacy task folder .lattice/tasks/{tid} kept: {problem}; reconcile it by hand"
    shutil.rmtree(folder)
    return f"removed legacy task folder .lattice/tasks/{tid} (identical copy archived; commit the removal)"


