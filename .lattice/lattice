def cmd_task_claim(args) -> int:
    here = repo_root()
    root = primary_root(here)
    f, meta, body = find_task(root, args.id)
    owner = args.owner or default_owner()
    branch = args.branch or meta.get("branch") or f"task/{meta['id']}"
    main = default_branch(root)
    held = {other["branch"]: other["id"] for _, other, _ in iter_tasks(root)
            if other["id"] != meta["id"] and other["status"] in ("in_progress", "done")
            and other.get("branch")}

    if branch == main or branch in PROTECTED_BRANCHES:
        raise SystemExit("error: a task needs its own branch, not the mainline")
    if not args.worktree and here != root:
        raise SystemExit("error: plain claim runs in the primary tree; use --worktree for another task")
    destination = lat_dir(root) / "worktrees" / meta["id"] if args.worktree else root
    for _, other, _ in iter_tasks(root):
        if other["id"] != meta["id"] and other["status"] in ("in_progress", "done") \
                and (root / (other.get("tree") or other.get("worktree") or ".")).resolve() == destination:
            raise SystemExit(f"error: this tree is held by task {other['id']} — use --worktree or release/archive it first")

    if meta["status"] == "done":
        raise SystemExit("error: task is done — archive it instead of claiming it")
    if meta["status"] == "in_progress" and not args.force:
        raise SystemExit(
            f"error: already claimed by {meta.get('owner')} at {meta.get('claimed')} "
            f"— another session may be working on it (--force to take over)")
    if meta["status"] == "in_progress" and (branch != meta.get("branch") or
            destination != (root / (meta.get("tree") or meta.get("worktree") or ".")).resolve()):
        raise SystemExit("error: release the task before moving its claim to another tree or branch")
    if branch in held:
        raise SystemExit(
            f"error: branch '{branch}' is held by in-progress task "
            f"{held[branch]} — one branch per task")

    # Bind the claim to real git state first; record it only if that succeeds.
    # A new task branch starts from main, never from whatever another task
    # happens to have checked out in this tree.
    new_branch = not branch_exists(root, branch)
    base = [main] if new_branch and main else []
    worktree = ""
    if args.worktree:
        wt = lat_dir(root) / "worktrees" / meta["id"]
        if wt.exists():
            if not args.force:
                raise SystemExit(
                    f"error: {wt} already exists — task not claimed "
                    f"(--force to take it over, or remove it)")
            print(f"reusing existing worktree {wt}")
            task_tree(root, {**meta, "tree": str(wt.relative_to(root)), "branch": branch}, here)
        else:
            wt.parent.mkdir(parents=True, exist_ok=True)
            add = ["worktree", "add", "-b", branch, str(wt), *base] if new_branch \
                else ["worktree", "add", str(wt), branch]
            rc, _, err = run_git(root, *add)
            if rc != 0:
                raise SystemExit(f"error: worktree add failed, task not claimed: {err}")
        worktree = str(wt.relative_to(root))
    elif current_branch(here) != branch:
        on = current_branch(here)
        if on in held:
            raise SystemExit(
                f"error: this tree is on {on}, held by in-progress task "
                f"{held[on]} — claim with --worktree or finish that task first "
                f"(task not claimed)")
        if is_dirty(here):
            raise SystemExit("error: commit this tree's changes before claiming another branch")
        switch = ["switch", "-c", branch, *base] if new_branch \
            else ["switch", branch]
        rc, _, err = run_git(here, *switch)
        if rc != 0:
            raise SystemExit(
                f"error: could not switch {here.name} to {branch}, task not "
                f"claimed: {err}")
        print(f"switched {here.name} to branch {branch}"
              + (f" (from {main})" if base else ""))

    meta.update(status="in_progress", owner=owner, branch=branch,
                worktree=worktree, tree=worktree or ".", claimed=now_iso(),
                verified="", done="")
    write_task(f, meta, body)
    print(f"claimed {meta['id']} as {owner} on branch {branch}")
    if worktree:
        print(f"worktree ready: {root / worktree}")
        print("work there; it is removed when this task is archived")
    return 0


def cmd_task_release(args) -> int:
    """Hand an in-progress task back: status open, owner cleared, a clean
    worktree removed, the branch kept so the next claim continues on it."""
    root = primary_root(repo_root())
    f, meta, body = find_task(root, args.id)
    if meta["status"] != "in_progress":
        raise SystemExit(
            f"error: status is '{meta['status']}' — only an in-progress task "
            f"can be released")
    wt_rel = meta.get("worktree", "")
    wt = root / wt_rel if wt_rel else None
    if wt and wt.exists():
        if wt.resolve() != lat_dir(root) / "worktrees" / meta["id"]:
            raise SystemExit("error: release only removes this task's managed worktree")
        task_tree(root, meta, root)
        if Path.cwd().resolve() == wt.resolve() or wt.resolve() in Path.cwd().resolve().parents:
            raise SystemExit(
                f"error: you are inside this task's worktree — run release "
                f"from the primary tree ({root})")
        if is_dirty(wt):
            raise SystemExit(
                f"error: worktree {wt} has uncommitted changes — commit or "
                f"discard them first (task stays in_progress)")
        rc, _, err = run_git(root, "worktree", "remove", str(wt))
        if rc != 0:
            raise SystemExit(
                f"error: could not remove worktree ({err}) — task stays in_progress")
        print(f"removed worktree {wt}")
    if not wt and current_branch(root) == meta.get("branch") and is_dirty(root):
        raise SystemExit("error: commit this tree's changes before release")
    meta.update(status="open", owner="", claimed="", worktree="", tree="",
                verified="", done="")
    write_task(f, meta, body)
    print(f"released {meta['id']} — branch {meta.get('branch') or '-'} kept; "
          f"the next claim continues on it")
    return 0


def contract_digest(meta: dict, body: str, folder: Path) -> str:
    fields = {k: meta.get(k, "") for k in ("id", "title", "branch", "tree", "worktree", "verify")}
    digest = hashlib.sha256((json.dumps(fields, sort_keys=True) + body).encode())
    outputs = {"task.md", "verification.json", "verification.log", "integration.json", "integration.log"}
    for path in sorted(folder.rglob("*")):
        rel = path.relative_to(folder)
        if rel.parts[0] == "evidence" or rel.as_posix() in outputs or path.name.startswith(".write-"):
            continue
        if path.is_symlink():
            raise SystemExit(f"error: task contract input must be an ordinary file: {path}")
        if path.is_file():
            digest.update(rel.as_posix().encode() + b"\0")
            with path.open("rb") as source:
                for chunk in iter(lambda: source.read(65536), b""):
                    digest.update(chunk)
            digest.update(b"\0")
    return digest.hexdigest()


def snapshot(tree: Path) -> dict:
    if is_dirty(tree):
        raise SystemExit(f"error: {tree} has uncommitted changes; commit before verification")
    rc, sha, _ = run_git(tree, "rev-parse", "HEAD")
    rc2, git_tree, _ = run_git(tree, "rev-parse", "HEAD^{tree}")
    branch = current_branch(tree)
    if rc or rc2 or not branch:
        raise SystemExit("error: verification requires a committed, attached branch")
    return {"commit": sha, "git_tree": git_tree, "checkout_branch": branch}


def invalidate(f: Path) -> None:
    meta, body = read_task(f)
    meta.update(status="in_progress", verified="", done="")
    write_task(f, meta, body)


def verify_tree(f: Path, meta: dict, body: str, tree: Path,
                name: str, attestation=None) -> dict:
    before = snapshot(tree)
    cmd = meta.get("verify", "")
    if attestation is not None and not attestation.strip():
        raise SystemExit("error: evidence must describe an actual observation")
    if attestation is None and not cmd:
        raise SystemExit("error: set verify or supply --evidence describing what you verified")
    record = {"schema": 1, "task_id": meta["id"], "task_branch": meta["branch"],
              "checkout": str(tree), **before, "contract": contract_digest(meta, body, f.parent),
              "command": cmd, "kind": "attested" if attestation is not None else "command",
              "attestation": attestation, "started": now_iso(), "status": "running"}
    target = f.parent / (name + ".json")
    try:
        previous = json.loads(target.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        previous = {}  # Corrupt old evidence cannot block a fresh attempt.
    attempts = previous.get("attempt", 0) if isinstance(previous, dict) else 0
    record["attempt"] = attempts + 1 if isinstance(attempts, int) else 1
    write_json(target, record)
    started = time.monotonic()
    try:
        if attestation is None:
            print(f"verify: {cmd}\n(in {tree})", flush=True)
            log = f.parent / (name + ".log")
            with log.open("wb") as output:
                rc = subprocess.run(cmd, shell=True, cwd=str(tree), stdin=subprocess.DEVNULL,
                                    stdout=output, stderr=subprocess.STDOUT,
                                    env={**os.environ, "LATTICE_TASK_DIR": str(f.parent)}).returncode
            with log.open("rb") as output:
                size = output.seek(0, 2)
                output.seek(max(0, size - 65536))
                tail_bytes = output.read()
                tail = tail_bytes.decode("utf-8", errors="replace")
            if size > 65536:
                prefix = b"[Earlier output truncated]\n"
                with log.open("wb") as output:
                    output.write(prefix + tail_bytes[-(65536 - len(prefix)):])
            if tail:
                print(tail[-6000:], end="" if tail.endswith("\n") else "\n")
                print(f"verification log: {log}")
            record["exit_code"] = rc
            if rc:
                raise SystemExit(f"error: verify failed (exit {rc}); task is in_progress")
        else:
            record["exit_code"] = None
        if snapshot(tree) != before or contract_digest(*read_task(f), folder=f.parent) != record["contract"]:
            raise SystemExit("error: code, branch, or task contract changed during verification; run it again")
        record["status"] = "passed"
    except BaseException as error:
        record.update(status="failed", error=str(error))
        raise
    finally:
        record.update(finished=now_iso(), duration_seconds=round(time.monotonic() - started, 3))
        write_json(target, record)
    return record


def fresh_evidence(root: Path, f: Path, meta: dict, body: str) -> dict:
    record = read_json(f.parent / "verification.json")
    rc, sha, _ = run_git(root, "rev-parse", "--verify", "refs/heads/" + meta.get("branch", ""))
    _, git_tree, _ = run_git(root, "rev-parse", "--verify", "refs/heads/" + meta.get("branch", "") + "^{tree}")
    expected_tree = str((root / (meta.get("tree") or meta.get("worktree") or ".")).resolve())
    if not isinstance(record, dict) or record.get("schema") != 1 \
            or record.get("status") != "passed" or not meta.get("verified") \
            or record.get("kind") not in ("command", "attested") \
            or record.get("git_tree") != git_tree \
            or record.get("checkout_branch") != meta.get("branch") \
            or record.get("task_id") != meta["id"] \
            or record.get("task_branch") != meta.get("branch") \
            or record.get("checkout") != expected_tree \
            or record.get("contract") != contract_digest(meta, body, f.parent) \
            or rc or record.get("commit") != sha:
        raise SystemExit("error: verification is stale or mismatched; restore the task checkout and run task done again")
    return record


def cmd_task_done(args) -> int:
    here = repo_root()
    root = primary_root(here)
    f, meta, body = find_task(root, args.id)
    if meta["status"] not in ("in_progress", "done"):
        raise SystemExit("error: task was never claimed — claim it first")
    # Revoke completion before every attempt, including invalid checkout and
    # interrupted verification. A success from yesterday cannot survive a failure.
    invalidate(f)
    tree = task_tree(root, meta, here)
    print("Handoff reminder: reconcile remaining work, constraints, changed operational "
          "prerequisites, and evidence limits; update maintained sources and .lattice/knowledge.md.")
    with locked(root, "tree:" + str(tree)):
        record = verify_tree(f, meta, body, tree, "verification", args.evidence)
    summary = f"{'attested' if args.evidence else 'pass'} {record['finished']} @{record['commit']}"
    meta.update(status="done", done=now_iso(), verified=summary)
    write_task(f, meta, body)
    print(f"done {meta['id']} — {summary}")
    print(f"next: merge {meta['branch']} into {default_branch(root) or 'main'}, then: lattice task archive {meta['id']}")
    return 0


