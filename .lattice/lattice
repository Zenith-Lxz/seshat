ARCHIVE_WARN_BYTES = 256 * 1024


def folder_sizes(folder: Path):
    """Total bytes and the five largest files of an archived task folder."""
    sizes = [(p.stat().st_size, p.relative_to(folder).as_posix())
             for p in folder.rglob("*") if p.is_file() and not p.is_symlink()]
    return sum(size for size, _ in sizes), sorted(sizes, reverse=True)[:5]


def cmd_task_archive(args) -> int:
    root = primary_root(repo_root())
    f, meta, body = find_task(root, args.id)
    if meta["status"] != "done":
        raise SystemExit("error: task must be done before archive")
    proof = fresh_evidence(root, f, meta, body)
    main = default_branch(root)
    branch = meta.get("branch", "")
    if not main or branch == main or branch in PROTECTED_BRANCHES:
        raise SystemExit("error: archive requires a separate task branch and an existing mainline")
    if current_branch(root) != main:
        raise SystemExit(f"error: switch the primary tree to {main} before archive")
    if run_git(root, "merge-base", "--is-ancestor", branch, main)[0] != 0:
        raise SystemExit(f"error: {branch} is not merged into {main}")
    wt = root / meta["worktree"] if meta.get("worktree") else None
    if wt:
        expected = lat_dir(root) / "worktrees" / meta["id"]
        if wt.resolve() != expected or not wt.is_dir():
            raise SystemExit("error: recorded worktree is missing or not the task's managed directory")
        if Path.cwd().resolve() == wt.resolve() or wt.resolve() in Path.cwd().resolve().parents:
            raise SystemExit("error: run archive from the primary tree")
        task_tree(root, meta, root)
        if is_dirty(wt):
            raise SystemExit("error: task worktree is dirty; commit before archive")
    dest = lat_dir(root) / "tasks/archive" / datetime.date.today().strftime("%Y-%m") / meta["id"]
    if dest.exists():
        raise SystemExit(f"error: archive destination already exists: {dest}")
    with locked(root, "tree:" + str(root)):
        merged = snapshot(root)
        if merged["git_tree"] == proof["git_tree"] and args.evidence is None:
            integration = {**proof, **merged, "checkout": str(root), "kind": "same-tree",
                           "reused_task_commit": proof["commit"]}
            write_json(f.parent / "integration.json", integration)
        else:
            if proof["kind"] == "attested" and args.evidence is None:
                raise SystemExit("error: the merged tree differs from the manually verified tree; verify it and use task archive --evidence")
            try:
                verify_tree(f, meta, body, root, "integration", args.evidence)
            except BaseException:
                invalidate(f)
                raise
        # Verification does not hold the board lock. Recheck before cleanup;
        # unrelated tasks can progress throughout the potentially long command.
        with locked(root, "board"):
            fresh_evidence(root, f, *read_task(f))
            if snapshot(root) != merged:
                raise SystemExit("error: mainline changed during archive; retry verification")
            if wt and is_dirty(wt):
                raise SystemExit("error: task worktree changed during archive")
            dest.parent.mkdir(parents=True, exist_ok=True)
            if wt:
                rc, _, err = run_git(root, "worktree", "remove", str(wt))
                if rc:
                    raise SystemExit(f"error: could not remove worktree: {err}; task retained")
                print(f"removed worktree {wt}")
            rc, _, err = run_git(root, "branch", "-d", branch)
            if rc:
                print(f"warn: merged branch kept: {err}")
            else:
                print(f"deleted merged branch {branch}")
            shutil.move(str(f.parent), str(dest))
            retired = retire_legacy_folder(root, meta["id"])
    print(f"archived {meta['id']} -> {dest}")
    if retired:
        print(retired)
    total, largest = folder_sizes(dest)
    if total > ARCHIVE_WARN_BYTES:
        print(f"warn: task folder is {total // 1024} KiB; evidence should be logs, receipts, "
              f"digests, and patches — trim copies of other repositories before committing:")
        for size, rel in largest:
            print(f"  {size // 1024:>6} KiB  {rel}")
    print(f"next: commit .lattice/tasks on {main}")
    print(CONSOLIDATION_CHECKLIST)
    return 0


# ---------- doctor & context ----------

def cmd_doctor(args) -> int:
    here = repo_root()
    root = primary_root(here)
    issues = entrypoint_issues(here) + knowledge_issues(here)
    broken = []
    tasks = list(iter_tasks(root, broken))
    issues.extend(broken)

    head = current_branch(root)
    main = default_branch(root)
    branches = {}
    now = datetime.datetime.now().astimezone()
    for f, meta, _ in tasks:
        tid = meta["id"]
        if tid != f.parent.name:
            issues.append(f"{f.parent.name}: task id '{tid}' does not match its directory")
        if meta["status"] not in ("open", "in_progress", "done"):
            issues.append(f"{tid}: unknown status '{meta['status']}'")
        if meta["status"] != "done":
            problem = verify_issue(meta.get("verify", ""))
            if problem:
                issues.append(f"{tid}: {problem}")
        if meta["status"] == "in_progress":
            b = meta.get("branch", "")
            wt_rel = meta.get("worktree", "")
            if not meta.get("owner") or not b:
                issues.append(f"{tid}: in_progress but missing owner/branch")
            if b in branches:
                issues.append(
                    f"{tid} and {branches[b]}: both in_progress on branch '{b}'")
            elif b:
                branches[b] = tid
            if b and not branch_exists(root, b):
                issues.append(f"{tid}: claimed branch '{b}' does not exist")
            if wt_rel and not (root / wt_rel).exists():
                issues.append(f"{tid}: recorded worktree {wt_rel} is missing")
            if not wt_rel and b and b != head:
                issues.append(
                    f"{tid}: claimed on '{b}' without a worktree, but the "
                    f"primary tree is on '{head or '?'}' — switch to it or "
                    f"claim --worktree")
            claimed = meta.get("claimed", "")
            if claimed:
                try:
                    age = (now - datetime.datetime.fromisoformat(claimed)).days
                    if age > STALE_CLAIM_DAYS:
                        issues.append(
                            f"{tid}: claim is {age} days old "
                            f"(owner {meta.get('owner')}) — stale? `task release` "
                            f"it or claim --force")
                except ValueError:
                    issues.append(f"{tid}: unparseable claimed timestamp")
        elif meta["status"] == "done":
            if not meta.get("verified"):
                issues.append(f"{tid}: done without a verification record")
            issues.append(f"{tid}: done but not archived — consolidation pending")

    # Imported legacy folders are provenance until archive; afterwards they only
    # look like live records. Report them here; archive retires identical ones.
    for legacy in sorted((lat_dir(root) / "tasks").glob("*/task.md")):
        tid = legacy.parent.name
        if tid == "archive":
            continue
        archived = archived_task(root, tid)
        if archived is not None:
            problem = legacy_folder_issue(legacy.parent, archived)
            issues.append(f"legacy task folder .lattice/tasks/{tid} is archived — "
                          + (f"{problem}; reconcile it by hand" if problem
                             else "remove it (identical copy archived)"))
        elif not (tasks_dir(root) / tid / "task.md").is_file():
            issues.append(f"legacy task folder .lattice/tasks/{tid} is not imported — run `lattice init`")

    wt_dir = lat_dir(root) / "worktrees"
    active = {m["id"] for _, m, _ in tasks if m["status"] in ("in_progress", "done")}
    if wt_dir.is_dir():
        for d in wt_dir.iterdir():
            if d.is_dir() and d.name not in active:
                issues.append(
                    f"worktree '{d.name}' has no in-progress task — merge "
                    f"finished work and remove it")

    # Two live task branches must not share commits that main lacks: that means
    # one was branched from the other instead of from main.
    live = [(tid, b) for b, tid in branches.items() if branch_exists(root, b)]
    for i, (ta, ba) in enumerate(live):
        for tb, bb in live[i + 1:]:
            _, fork, _ = run_git(root, "merge-base", ba, bb)
            if main and fork and run_git(root, "merge-base", "--is-ancestor",
                                         fork, main)[0] != 0:
                issues.append(
                    f"{ta} and {tb}: '{ba}' and '{bb}' share commits that "
                    f"{main} lacks — one was branched from the other; rebase "
                    f"it onto {main}")

    for f, meta, body in tasks:
        if meta["status"] == "done":
            try:
                fresh_evidence(root, f, meta, body)
            except SystemExit as error:
                issues.append(f"{meta['id']}: {error}")

    if issues:
        for i in issues:
            print(f"warn: {i}")
        return 1
    print("ok: lattice state is healthy")
    return 0


def cmd_context(args) -> int:
    here = repo_root()
    root = primary_root(here)
    broken = []
    tasks = list(iter_tasks(root, broken))
    blocks = [f"# Lattice context — {root.name} (lattice {VERSION})",
              "Manual: AGENTS.md (loaded natively by Claude Code and Codex; any other agent reads it now)",
              "Knowledge: .lattice/knowledge.md. Before declaring information missing, use "
              '`python3 .lattice/lattice find "<term>"` (docs, shared notes, archives; locations only).']

    def section(title, content, budget, pointer):
        if len(content) > budget:
            content = content[:budget] + f"\n(... truncated; {pointer})"
        blocks.append(f"## {title}\n\n{content}")

    current = next(((f, m, body) for f, m, body in tasks
                    if m["status"] in ("in_progress", "done")
                    and (root / (m.get("tree") or m.get("worktree") or ".")).resolve() == here
                    and m.get("branch") == current_branch(here)), None)
    if current:
        f, m, body = current
        attachments = ", ".join(p.name for p in sorted(f.parent.glob("*.md"))[:12]
                                if p != f and not p.is_symlink())
        section(f"Current task: {m['id']} — {m.get('title', '')}",
                f"Status: {m['status']}; verify: {m.get('verify') or '(manual evidence required)'}\n"
                f"Task file: {f}\n"
                + (f"Also read in this task folder: {attachments}\n" if attachments else "")
                + f"\n{body.strip()}", 2400, f"read {f}")
    elif here != root:
        blocks.append("This worktree has no matching claimed task; inspect task list before working.")

    knowledge = bounded_markdown(here / KNOWLEDGE_PATH, here, 65536)
    if knowledge:
        section("Project knowledge (curated source map)", knowledge, 1500,
                "read .lattice/knowledge.md")

    warnings = entrypoint_issues(here) + knowledge_issues(here) + broken
    if warnings:
        section("Warnings", "\n".join(warnings), 700, "run lattice doctor")

    status = git(here, "status", "--short", "--branch").splitlines()
    status_text = "\n".join(status[:CONTEXT_STATUS_LINES])
    if len(status) > CONTEXT_STATUS_LINES:
        status_text += f"\n(... {len(status) - CONTEXT_STATUS_LINES} more changed paths — run git status)"
    section("Git", status_text + "\n\n" + git(here, "log", "--oneline", "-6"),
            1800, "run git status / git log")
    board = "\n".join(f"- [{m['status']}] {m['id']} (owner: {m.get('owner') or '-'}, "
                      f"branch: {m.get('branch') or '-'}) {m.get('title', '')} — {f}"
                      for f, m, _ in tasks) or "(none)"
    section("Tasks (shared local runtime)", board, 1300, "run lattice task list")
    for name in ("spec", "intent"):
        rows = []
        for f in sorted((lat_dir(here) / name).rglob("*.md")):
            with f.open(encoding="utf-8") as fh:
                title = next((ln.lstrip("# ").strip() for ln in fh if ln.startswith("# ")), "")
            rows.append(f"- {f.relative_to(here)} — {title[:140]}")
        if rows:
            section(f"{name}/ index", "\n".join(rows), 750, f"browse .lattice/{name}/")
    blocks.append("Reminder: verify before trusting any 'done'; runtime is local, contracts and archives belong in git.")
    output = "\n\n".join(blocks)
    if len(output) >= CONTEXT_CHARS:
        output = output[:CONTEXT_CHARS - 85] + "\n(... context budget reached; read the task file and indexes above)"
    print(output)
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="lattice", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init", help="scaffold .lattice/ and agent files in this repo")
    pi.add_argument("--from-openspec", action="store_true",
                    help="first move an openspec/ tree into .lattice/ (specs, "
                         "changes, archive, config) and remove OpenSpec tool files")
    pi.add_argument("--hooks", choices=("project", "user"), help="explicitly select this machine's hook mode")
    pi.add_argument("--user-dir", help="installed user integration directory (default: ~/.local/share/lattice)")
    sub.add_parser("context", help="print session-start bundle for a fresh agent")
    pf = sub.add_parser("find", help="find literal text in project docs, task notes, and archives")
    pf.add_argument("query")
    pf.add_argument("--limit", type=int, default=20, help="maximum matching files (1-50)")
    sub.add_parser("doctor", help="lint lattice state (exit 1 on issues)")
    hooks = sub.add_parser("hooks", help="explicit user-level integration").add_subparsers(
        dest="hooks_cmd", required=True)
    hi = hooks.add_parser("install", help="install a central CLI and merge user SessionStart hooks")
    hi.add_argument("--user-dir")
    hi.add_argument("--codex-config", help="override the user Codex hooks.json location")
    hi.add_argument("--claude-config", help="override the user Claude settings.json location")
    hs = hooks.add_parser("status", help="inspect installed hooks and enrolled projects")
    hs.add_argument("--user-dir")
    hc = hooks.add_parser("context", help="read SessionStart JSON from stdin; run only through the installed entrypoint")
    hc.add_argument("--agent", choices=tuple(HOOK_FILES), required=True)

    t = sub.add_parser("task", help="task lifecycle").add_subparsers(
        dest="task_cmd", required=True)
    tn = t.add_parser("new", help="create a task")
    tn.add_argument("title")
    tn.add_argument("--verify", help="shell command that defines done; it runs in the "
                                     "task checkout with $LATTICE_TASK_DIR set to the task folder")
    tc = t.add_parser("claim", help="claim a task: switches to its branch or "
                                    "creates a worktree, then records the claim")
    tc.add_argument("id")
    tc.add_argument("--owner", help="defaults to $LATTICE_OWNER, else claude/"
                                    "codex detected from the environment, else "
                                    "your username")
    tc.add_argument("--branch")
    tc.add_argument("--worktree", action="store_true",
                    help="create .lattice/worktrees/<id> on the task branch "
                         "for parallel sessions")
    tc.add_argument("--force", action="store_true",
                    help="take over a task another session holds")
    tr = t.add_parser("release", help="hand an in-progress task back: status "
                                      "open, clean worktree removed, branch kept")
    tr.add_argument("id")
    td = t.add_parser("done", help="run the verify command and record the result")
    td.add_argument("id")
    td.add_argument("--evidence", help="single line describing verification "
                                       "you already ran, instead of running "
                                       "the verify command")
    tl = t.add_parser("list", help="list tasks")
    tl.add_argument("--status")
    ta = t.add_parser("archive", help="archive a merged, verified, clean task "
                                      "(prints consolidation)")
    ta.add_argument("id")
    ta.add_argument("--evidence", help="manual evidence for a changed merged tree")

    args = p.parse_args()
    if args.cmd == "hooks":
        return {"install": cmd_hooks_install, "status": cmd_hooks_status,
                "context": cmd_hooks_context}[args.hooks_cmd](args)
    handlers = {
        ("init", None): cmd_init,
        ("context", None): cmd_context,
        ("find", None): cmd_find,
        ("doctor", None): cmd_doctor,
        ("task", "new"): cmd_task_new,
        ("task", "claim"): cmd_task_claim,
        ("task", "release"): cmd_task_release,
        ("task", "done"): cmd_task_done,
        ("task", "list"): cmd_task_list,
        ("task", "archive"): cmd_task_archive,
    }
    handler = handlers[(args.cmd, getattr(args, "task_cmd", None))]
    root = primary_root(repo_root())
    runtime_format = runtime_dir(root) / "format"
    if runtime_format.exists() and runtime_format.read_text().strip() != "1":
        raise SystemExit("error: unsupported task runtime format; use its matching Lattice version")
    if args.cmd != "init" and not runtime_format.is_file():
        if not (lat_dir(root) / "lattice").is_file():
            raise SystemExit("error: run lattice init in this repository first")
        with locked(root, "board"):
            if not runtime_format.exists():
                migrate_task_state(root, announce=False)
    if args.cmd != "task" or args.task_cmd == "list":
        return handler(args)
    if args.task_cmd == "new":
        with locked(root, "board"):
            return handler(args)
    check_task_id(args.id)
    with locked(root, "task:" + args.id):
        if args.task_cmd in ("claim", "release"):
            with locked(root, "board"):
                if args.task_cmd == "claim":
                    tree = lat_dir(root) / "worktrees" / args.id if args.worktree else root
                else:
                    _, meta, _ = find_task(root, args.id)
                    tree = root / (meta.get("tree") or meta.get("worktree") or ".")
                with locked(root, "tree:" + str(tree.resolve())):
                    return handler(args)
        if args.task_cmd == "archive":
            _, meta, _ = find_task(root, args.id)
            if meta.get("worktree"):
                with locked(root, "tree:" + str((root / meta["worktree"]).resolve())):
                    return handler(args)
        return handler(args)


if __name__ == "__main__":
    sys.exit(main())
